# Copy to deploy/.env. Compose reads it from the project directory
# when you run `docker compose --env-file deploy/.env -f deploy/docker-compose.yml up`.
# From deploy/: `docker compose up` loads .env automatically.
#
# The password is not in here: set it once with
#   docker compose run --rm belegapp set-password

BELEGAPP_BASE_URL=https://belege.example.de
BELEGAPP_TRUSTED_PROXIES=172.16.0.0/12

# Only needed when the OIDC lines in docker-compose.yml are uncommented.
BELEGAPP_OIDC_ISSUER_URL=https://auth.example.de
BELEGAPP_OIDC_CLIENT_ID=belegapp
BELEGAPP_OIDC_ALLOWED_EMAILS=eduard@example.de

# Only needed with the forward-auth lines in docker-compose.yml. The proxy has
# to write the header it names, and has to run on one of the networks in
# BELEGAPP_TRUSTED_PROXIES above.
# BELEGAPP_AUTH_HEADER_ALLOWED=eduard@example.de

# Paths are relative to the compose file. OIDC_SECRET_FILE is only needed for a
# confidential client; a public client (PKCE only) leaves it unset.
OIDC_SECRET_FILE=./secrets/oidc_secret
LLM_API_KEY_FILE=./secrets/openai_key
