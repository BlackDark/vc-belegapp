# Copy to deploy/.env. Compose reads it from the project directory
# when you run `docker compose --env-file deploy/.env -f deploy/docker-compose.yml up`.
# From deploy/: `docker compose up` loads .env automatically.

BELEGAPP_BASE_URL=https://belege.example.de
BELEGAPP_TRUSTED_PROXIES=172.16.0.0/12
BELEGAPP_OIDC_ISSUER_URL=https://auth.example.de
BELEGAPP_OIDC_CLIENT_ID=belegapp
BELEGAPP_OIDC_ALLOWED_EMAILS=eduard@example.de

# Paths are relative to the compose file.
OIDC_SECRET_FILE=./secrets/oidc_secret
PASSWORD_HASH_FILE=./secrets/pw_hash
LLM_API_KEY_FILE=./secrets/openai_key
